{
  "name": "pantri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first office pantry inventory PWA with barcode scanning (no build step).",
  "scripts": {
    "vendor": "node tools/vendor.mjs",
    "serve": "node tools/serve.mjs",
    "stamp": "node tools/stamp.mjs",
    "test": "node --test \"tests/**/*.test.{js,mjs}\"",
    "icons": "node tools/make-icons.mjs",
    "check:barcode": "node tools/check-barcode.mjs",
    "e2e": "node tests/smoke.e2e.mjs && node tests/flow.e2e.mjs && node tests/sites.e2e.mjs",
    "deploy": "node tools/deploy.mjs"
  },
  "devDependencies": {
    "barcode-detector": "3.2.2",
    "esbuild": "0.28.2",
    "htm": "3.1.1",
    "playwright-core": "1.64.0",
    "preact": "11.0.1"
  }
}
